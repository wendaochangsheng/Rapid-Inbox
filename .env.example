# Copy this file to `.env` and edit the values you actually want to use.
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/app.db
BOOTSTRAP_ADMIN_USERNAME=admin
# Local-dev bootstrap password used by the default launcher flow.
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
SESSION_COOKIE_NAME=rapid_inbox_session
# Keep the management/API plane loopback-only unless an HTTPS reverse proxy is
# deliberately configured in front of it.
HOST=127.0.0.1
PORT=8000
# Applies to both Content-Length and streamed/chunked ASGI request bodies.
HTTP_MAX_REQUEST_BODY_BYTES=1048576
# Total wall-clock time allowed to finish receiving one HTTP request body.
HTTP_REQUEST_BODY_TIMEOUT_SECONDS=15
# Shared in-process budget for buffered HTTP request bodies.
HTTP_BODY_MEMORY_BUDGET_BYTES=268435456
# Total HTTP/WebSocket tasks admitted per process. quickstart also passes this
# value to Uvicorn's --limit-concurrency admission control.
HTTP_CONCURRENCY_LIMIT=1000
# Shared per-process cap for admin SSE and public mailbox WebSocket streams.
HTTP_LIVE_CONNECTION_LIMIT=256
DATABASE_WRITE_QUEUE_CAPACITY=256
DATABASE_WRITE_MAX_WAITERS=1024
# API v2 read actors and their central bounded admission queues. Tiny SQLite
# reads are fastest with one actor because Python row hydration is GIL-bound;
# raise the pool only after workload-specific long-query benchmarks show gains.
# Limits are per HTTP process; timeout covers admission, queued and executing time.
DATABASE_READ_POOL_SIZE=1
DATABASE_READ_QUEUE_CAPACITY=256
DATABASE_READ_MAX_WAITERS=1024
DATABASE_READ_TIMEOUT_SECONDS=5
SMTP_HOST=0.0.0.0
SMTP_PORT=25
MAX_MESSAGE_SIZE_BYTES=52428800
MAX_RECIPIENTS_PER_MESSAGE=20
SMTP_IDLE_TIMEOUT_SECONDS=30
# The Python compatibility listener must never be unbounded on a public bind.
SMTP_MAX_CONCURRENT_CONNECTIONS=1024
# Shared with C++ ingestd. 60,000/minute keeps burst throughput while bounding
# per-IP connection-churn state; set a lower value for an abuse-prone edge.
SMTP_CONNECTION_RATE_LIMIT_COUNT=60000
SMTP_CONNECTION_RATE_LIMIT_WINDOW_SECONDS=60
SMTP_CLOSE_AFTER_DATA=true
PARSE_WORKER_COUNT=4
# Includes queued and actively parsing messages. The byte budget must be at
# least MAX_MESSAGE_SIZE_BYTES; durable pending rows are retried when full.
PARSE_QUEUE_MAX_MESSAGES=10000
PARSE_QUEUE_MAX_BYTES=536870912
# Public/admin detail responses read only bounded previews. Original EML and
# attachment download routes remain streamed and untruncated.
MESSAGE_PREVIEW_BODY_BYTES=131072
MESSAGE_PREVIEW_HEADERS_BYTES=65536
# Raw source-byte budgets for CID inline images embedded as data URLs.
MESSAGE_PREVIEW_INLINE_ITEM_BYTES=65536
MESSAGE_PREVIEW_INLINE_TOTAL_BYTES=262144
FSYNC_STORAGE_WRITES=false

# C++ rapid-inbox-ingestd hot-path limits. These are separate from the Python
# compatibility SMTP listener settings above.
SMTP_MAX_CONNECTIONS=1024
SMTP_MAX_LINE_LENGTH=1000
SMTP_LISTEN_BACKLOG=1024
INGEST_QUEUE_MAX_MESSAGES=10000
INGEST_QUEUE_MAX_BYTES=536870912
# DATA bodies grow this reservation at a time instead of reserving the whole
# maximum message size per connection.
INGEST_RESERVATION_CHUNK_BYTES=65536
INGEST_BATCH_MAX_MESSAGES=250
INGEST_FLUSH_INTERVAL_MS=5
INGEST_SQLITE_BUSY_TIMEOUT_MS=5000
INGEST_WORKER_COUNT=4
INGEST_MAX_RETRIES=3
DOMAIN_RELOAD_INTERVAL_MS=1000
# Persist raw + pending manifest before SMTP 250. Keep enabled in production.
INGEST_DURABLE_ACK=true
# Enable for power-loss durability; this trades throughput for fsync latency.
INGEST_STORAGE_FSYNC=false

DISK_WARNING_THRESHOLD_PERCENT=85
# managed_only accepts configured domains. managed_plus_catchall also accepts
# every syntactically valid recipient domain already routed to this SMTP server
# through a '*' policy that is private by default; it does not change DNS/MX.
INGRESS_MODE=managed_only
CATCH_ALL_PUBLIC_WEB_ENABLED=false
CATCH_ALL_PUBLIC_API_ENABLED=false
# 0 means catch-all deliveries do not expire automatically.
CATCH_ALL_RETENTION_DAYS=0
RETENTION_CLEANUP_INTERVAL_SECONDS=30
SMTP_SESSION_RETENTION_SECONDS=86400
EMPTY_MAILBOX_RETENTION_SECONDS=86400
METRIC_RETENTION_SECONDS=604800
AUDIT_RETENTION_DAYS=90
CLEANUP_BATCH_SIZE=1000
FILE_GC_BATCH_SIZE=500
MAINTENANCE_RUN_RETENTION_DAYS=30
QUARANTINE_RETENTION_DAYS=30
# Unreferenced raw/text/html/attachment files younger than this stay protected.
ORPHAN_ARTIFACT_GRACE_SECONDS=86400
ARTIFACT_SWEEP_BATCH_SIZE=500
# Shared by the Python control plane and C++ ingestd. JSON is recommended for
# production collection; DEBUG enables per-connection/message ingest events.
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true
# Required when METRICS_ENABLED=true and HOST is not loopback; otherwise the
# service refuses to start. Leave unset only for loopback-only development.
# METRICS_TOKEN=replace-with-a-long-random-token
# Required for HMAC-signed API v2 cursors on non-loopback binds. quickstart
# generates this automatically; manual deployments need at least 32 random chars.
API_CURSOR_SECRET=
READINESS_MIN_FREE_DISK_BYTES=67108864
# Optional legacy token compatibility. Leave commented unless you replace them
# with long random values; built-in demo values are not accepted at runtime.
# ADMIN_TOKEN=replace-with-a-long-random-admin-token
# PUBLIC_API_KEY=replace-with-a-long-random-public-api-key
